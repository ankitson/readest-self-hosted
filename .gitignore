# Personal library data (book titles, ISBNs) used by the one-off
# metadata/migration scripts. Never commit: this repo is public.
/tmp/

# Run logs from the one-off migration/cleanup scripts. They record counts and
# outcomes for a personal library and occasionally name a book; keep them local.
/logs/
fastlane/staging/
fastlane/metadata-play/android/en-US/changelogs

apps/readest.koplugin/bin/
apps/readest.koplugin/native/localsend-bin/target/

# scripts/tauri.mjs parks the wry Cargo.lock here during a Linux CEF build
/Cargo.lock.wry

# Stale local clones from an older packages/ layout. Upstream tracks neither,
# .gitmodules declares neither, and nothing in the build references them — but
# they contain a .git, so a bare `git add -A` commits them as gitlinks.
/packages/tao/
/packages/tauri-plugins/
